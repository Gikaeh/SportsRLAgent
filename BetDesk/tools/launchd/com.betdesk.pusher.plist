<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.betdesk.pusher</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__REPO__/tools/pusher.sh</string></array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <!-- Every minute. The pusher itself decides: live games -> push scores; else a full push
       every 15 min; otherwise exit "idle". It only reads DeepSports' HTTP API, never DuckDB. -->
  <key>StartInterval</key><integer>60</integer>
  <key>EnvironmentVariables</key>
  <dict><key>NODE</key><string>__NODE__</string></dict>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/BetDesk/pusher.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/BetDesk/pusher.log</string>
</dict>
</plist>
