{
  "name": "betdesk-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply betdesk --local",
    "migrate:remote": "wrangler d1 migrations apply betdesk --remote",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:deploy": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  }
}
