// BetDesk Worker. Setup and deploy steps: ../docs/SETUP.md. Secrets are never in this file:
// ACCESS_TEAM_DOMAIN, ACCESS_AUD, ALLOWED_EMAILS, ORIGIN_URL, ORIGIN_CLIENT_ID and ORIGIN_CLIENT_SECRET
// are set with `wrangler secret put`.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "betdesk",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
