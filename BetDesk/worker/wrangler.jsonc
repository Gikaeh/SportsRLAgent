// BetDesk Worker. Setup and deploy steps: ../docs/SETUP.md. Secrets are never in this file:
// INGEST_TOKEN, ACCESS_TEAM_DOMAIN, ACCESS_AUD, ALLOWED_EMAILS are set with `wrangler secret put`.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "betdesk",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ingest"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "betdesk",
      // Replace with the id printed by `npx wrangler d1 create betdesk` (not a secret).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
